# Jenkins Environment Configuration
# Copy these environment variables to your Jenkins job configuration

# Deployment Configuration
# Uncomment and configure the deployment method you want to use:

# For GitHub Pages deployment:
# DEPLOY_TO_GITHUB_PAGES=true
# GITHUB_PAGES_REPO=git@github.com:yourusername/funny_moments.git

# For SSH/rsync deployment:
# DEPLOY_VIA_SSH=true
# DEPLOY_USER=your-server-user
# DEPLOY_HOST=your-server.com
# DEPLOY_PATH=/var/www/html

# For AWS S3 deployment:
# DEPLOY_TO_S3=true
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# Notification settings:
# NOTIFICATION_EMAIL=your-email@domain.com

# Hugo specific settings (these match your current GitLab CI setup):
GIT_SUBMODULE_STRATEGY=recursive
THEME_URL=github.com/adityatelange/hugo-PaperMod
